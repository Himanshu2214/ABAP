@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'MIGO Posting Interface View'
define root view entity ZI_MIGO_POSTING as select from DUMMY_VIEW 
{
  key client as Client,
  key cast( '00000000000000000000000000000001' as abap.numc( 32 ) ) as RequestId,
  cast( '' as abap.char( 10 ) ) as ZtypeGm,
  cast( '' as abap.char( 10 ) ) as ZsubType,
  cast( '' as abap.char( 10 ) ) as MovementType,
  cast( '00000000' as abap.dats ) as DocDate,
  cast( '00000000' as abap.dats ) as PstngDate,
  cast( '' as abap.char( 20 ) ) as GrGiSlipNo,
  cast( '' as abap.char( 50 ) ) as HeaderTxt,
  cast( '' as abap.char( 20 ) ) as MaterialDocument,
  cast( 'X' as abap_boolean ) as Success,
  cast( '' as abap.char( 255 ) ) as Message
}